// Config for the generic qr workflow pipeline (nf/main.nf). Picked up
// automatically because it sits next to main.nf.
params {
    plan_name = 'qr-workflow'
    fingerprint = ''
    cwd       = System.getProperty('user.dir')
    outdir    = 'runs/nextflow'
    pre       = []
    cases     = []
    post      = []
    has_pairs = false
    queue     = 'normal'
    // failure policy + concurrency (qr workflow run --on-error / --max-forks)
    on_error  = 'finish'   // finish | ignore | terminate | retry
    max_forks = 0          // 0 = nextflow default (one task per CPU)
    // image pinned by digest (repo/img@sha256:...); empty = run on the host
    container = ''
    bind      = ''         // extra docker/singularity bind mounts, comma-separated host paths
}

process {
    errorStrategy = params.on_error
    maxRetries    = params.on_error == 'retry' ? 2 : 0
    maxForks      = params.max_forks ? (params.max_forks as int) : null
    container     = params.container ?: null
}

// profiles docker/singularity bind params.cwd, params.outdir and params.bind into the
// container at the same path (tasks cd into params.cwd and write under outdir).

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = params.queue
    }
    docker {
        docker.enabled    = true
        docker.runOptions = ([params.cwd, params.outdir] + (params.bind ? params.bind.tokenize(',') : [])).unique().collect { "-v ${it}:${it}" }.join(' ')
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = ([params.cwd, params.outdir] + (params.bind ? params.bind.tokenize(',') : [])).unique().collect { "-B ${it}" }.join(' ')
    }
}

// Run provenance: per-task trace + HTML reports beside the published outputs.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}
